{
  "name": "movie-theater",
  "version": "1.0.0",
  "private": true,
  "description": "Root runner cho Movie Theater Backend (Express) và Frontend (React Native / Expo)",
  "scripts": {
    "dev": "node -e \"const {spawn}=require('child_process'),p=require('path');const b=spawn('npm',['run','dev'],{cwd:p.join(process.cwd(),'backend'),stdio:'inherit',shell:true});const f=spawn('npm',['start'],{cwd:p.join(process.cwd(),'frontend'),stdio:'inherit',shell:true});process.on('SIGINT',()=>{b.kill();f.kill();process.exit()});\"",
    "start": "node -e \"const {spawn}=require('child_process'),p=require('path');const b=spawn('npm',['start'],{cwd:p.join(process.cwd(),'backend'),stdio:'inherit',shell:true});const f=spawn('npm',['start'],{cwd:p.join(process.cwd(),'frontend'),stdio:'inherit',shell:true});process.on('SIGINT',()=>{b.kill();f.kill();process.exit()});\"",
    "dev:web": "node -e \"const {spawn}=require('child_process'),p=require('path');const b=spawn('npm',['run','dev'],{cwd:p.join(process.cwd(),'backend'),stdio:'inherit',shell:true});const f=spawn('npm',['run','web'],{cwd:p.join(process.cwd(),'frontend'),stdio:'inherit',shell:true});process.on('SIGINT',()=>{b.kill();f.kill();process.exit()});\"",
    "dev:android": "node -e \"const {spawn}=require('child_process'),p=require('path');const b=spawn('npm',['run','dev'],{cwd:p.join(process.cwd(),'backend'),stdio:'inherit',shell:true});const f=spawn('npm',['run','android'],{cwd:p.join(process.cwd(),'frontend'),stdio:'inherit',shell:true});process.on('SIGINT',()=>{b.kill();f.kill();process.exit()});\"",
    "dev:ios": "node -e \"const {spawn}=require('child_process'),p=require('path');const b=spawn('npm',['run','dev'],{cwd:p.join(process.cwd(),'backend'),stdio:'inherit',shell:true});const f=spawn('npm',['run','ios'],{cwd:p.join(process.cwd(),'frontend'),stdio:'inherit',shell:true});process.on('SIGINT',()=>{b.kill();f.kill();process.exit()});\"",
    "backend": "npm --prefix backend run dev",
    "frontend": "npm --prefix frontend start",
    "install:all": "npm --prefix backend install && npm --prefix frontend install",
    "check:backend": "node -c backend/server.js",
    "typecheck:frontend": "node ./frontend/node_modules/typescript/bin/tsc --noEmit -p ./frontend/tsconfig.json",
    "lint:frontend": "npm --prefix frontend run lint"
  }
}
