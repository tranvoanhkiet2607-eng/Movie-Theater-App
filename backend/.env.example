# ==============================================================================
# Movie Theater Backend — Môi Trường Cấu Hình (Environment Variables)
# ==============================================================================
# Hướng dẫn: Tạo bản sao của file này và đổi tên thành '.env' trong thư mục backend/
# ==============================================================================

# Cổng khởi chạy Express Server (Mặc định: 5000)
PORT=5000

# Chuỗi kết nối MongoDB Atlas (Thay thế <username> và <password> bằng thông tin thật)
# Lưu ý: Nếu mật khẩu có chứa ký tự đặc biệt như @, #, $, hệ thống sẽ tự động mã hóa URL.
MONGODB_URI=mongodb+srv://tranvoanhkiet2607_db_user:123456@Aa@cluster0.v5iqhza.mongodb.net/movie_theater?retryWrites=true&w=majority

# Khóa bí mật ký mã JSON Web Token (JWT) cho phiên xác thực người dùng
JWT_SECRET=movie_theater_secret_key_2026

# Thời hạn hiệu lực của JWT token (Mặc định: 30 ngày)
JWT_EXPIRES_IN=30d

# Môi trường chạy (development | production)
NODE_ENV=development

# ==============================================================================
# Cấu hình gửi Email OTP thực tế qua Nodemailer (Gmail / SMTP)
# ==============================================================================
# Hướng dẫn Gmail:
# 1. Bật xác thực 2 bước (2-Step Verification) trên tài khoản Google.
# 2. Tạo Mật khẩu ứng dụng (App Password) tại https://myaccount.google.com/apppasswords
# 3. Điền email và mật khẩu ứng dụng 16 ký tự vào EMAIL_USER và EMAIL_PASS dưới đây:
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_char_app_password
EMAIL_FROM="CineMax Theater" <noreply@cinemax.vn>

# Cấu hình SMTP máy chủ riêng (nếu không dùng Gmail):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
